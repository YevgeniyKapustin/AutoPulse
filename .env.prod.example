# Production env template — copy to the host (e.g. /run/env/*.env).
# Never commit real secrets. Rotate credentials per environment.
# Loaded via required env_file in compose.prod.yaml.
#
# Host shell ALSO needs non-empty vars for datastore bootstrap
# (compose.prod fails closed if they are missing):
#   RABBITMQ_USER, RABBITMQ_PASSWORD,
#   MYSQL_ROOT_PASSWORD, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE,
#   and for --profile observability: CLICKHOUSE_*, GRAFANA_*.
#
# App settings below reject weak defaults when ENVIRONMENT is not local
# (e.g. RABBITMQ_PASSWORD=autopulse will refuse to start).

RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=autopulse.cars

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=autopulse
MONGODB_COLLECTION_LISTINGS=listings
MONGODB_COLLECTION_INBOX=consumer_inbox
MONGODB_COLLECTION_OUTBOX=publisher_outbox

MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=autopulse_pricing

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

DEFAULT_TARGET_MARGIN_PCT=12.0
DEFAULT_TURNOVER_DAYS=21
AUTO_CREATE_TABLES=false
PRICER_MAX_RETRIES=5
PRICING_ENGINE=rules
RABBITMQ_QUORUM_QUEUES=true
RABBITMQ_HEARTBEAT_SEC=30

# Prod compose sets RUN_MODE per service (api vs worker). Do not set all.
LOG_LEVEL=INFO
ENVIRONMENT=production
ADMIN_UI_ENABLED=false
DEALER_UI_ENABLED=false
# Set a strong password if you enable either UI or call pricer /api/v1/admin.
UI_AUTH_USERNAME=autopulse
UI_AUTH_PASSWORD=
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
PRICER_BASE_URL=http://pricer:8002
CRAWLER_BASE_URL=http://crawler:8003
CV_WATERMARK_ENABLED=true
CV_PLATE_ENABLED=true
CV_PLATE_ONNX_PATH=services/enrichment/models/plate_yolov8n.onnx
CV_WATERMARK_ONNX_PATH=services/enrichment/models/scene_text_yolo11n.onnx
