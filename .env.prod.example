# Production env template — copy to the host (e.g. /run/env/*.env).
# Never commit real secrets. Rotate credentials per environment.
# Loaded via env_file in compose.prod.yaml (overrides are free of YAML defaults).

RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=autopulse.cars

MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=autopulse
MONGODB_COLLECTION_LISTINGS=listings

MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=autopulse_pricing

LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

DEFAULT_TARGET_MARGIN_PCT=12.0
DEFAULT_TURNOVER_DAYS=21
AUTO_CREATE_TABLES=false
PRICER_MAX_RETRIES=5
PRICING_ENGINE=rules

LOG_LEVEL=INFO
