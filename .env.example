# AutoPulse — environment template
# Copy to .env and adjust values for local development.

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=autopulse
RABBITMQ_PASSWORD=autopulse
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=autopulse.cars
RABBITMQ_HEARTBEAT_SEC=30
RABBITMQ_CONNECT_TIMEOUT_SEC=10
RABBITMQ_QUORUM_QUEUES=true
# If upgrading an existing volume from classic queues, wipe volumes or set false.

ROUTING_KEY_RAW_CREATED=car.raw.created
ROUTING_KEY_ENRICHED_SUCCESS=car.enriched.success
ROUTING_KEY_ENRICHMENT_FAILED=car.enrichment.failed
ROUTING_KEY_ENRICHMENT_DLQ=car.enrichment.dlq
ROUTING_KEY_PRICED_SUCCESS=car.priced.success
ROUTING_KEY_PRICER_DLQ=car.pricer.dlq

# --- MongoDB (enrichment state) ---
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=autopulse
MONGODB_COLLECTION_LISTINGS=listings
MONGODB_COLLECTION_INBOX=consumer_inbox
MONGODB_COLLECTION_OUTBOX=publisher_outbox

# --- MySQL (pricing results) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=autopulse
MYSQL_PASSWORD=autopulse
MYSQL_ROOT_PASSWORD=autopulse
MYSQL_DATABASE=autopulse_pricing

# --- Enrichment service ---
ENRICHMENT_HOST=0.0.0.0
ENRICHMENT_PORT=8001
# Local default: HTTP + consumer in one process. Prod splits api/worker.
RUN_MODE=all
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=3
CV_MAX_WORKERS=4
ENRICHMENT_MAX_RETRIES=5
ENRICHMENT_RETRY_BASE_DELAY_SEC=1
ENRICHMENT_RETRY_MAX_DELAY_SEC=30
SHUTDOWN_TIMEOUT_SEC=10
RABBITMQ_PREFETCH=4
RABBITMQ_CONNECTION_NAME=autopulse-enrichment

# --- Pricer service ---
PRICER_HOST=0.0.0.0
PRICER_PORT=8002
DEFAULT_TARGET_MARGIN_PCT=12.0
DEFAULT_TURNOVER_DAYS=21
AUTO_CREATE_TABLES=true
PRICER_MAX_RETRIES=5
PRICER_RETRY_BASE_DELAY_SEC=1
PRICER_RETRY_MAX_DELAY_SEC=30
PRICING_ENGINE=rules

# --- Observability ---
LOG_LEVEL=INFO
