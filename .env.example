# AutoPulse — environment template
# Copy to .env and adjust values for local development.

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=autopulse
RABBITMQ_PASSWORD=autopulse
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=autopulse.cars
RABBITMQ_HEARTBEAT_SEC=30
RABBITMQ_CONNECT_TIMEOUT_SEC=10
RABBITMQ_QUORUM_QUEUES=true
# If upgrading an existing volume from classic queues, wipe volumes or set false.

ROUTING_KEY_RAW_CREATED=car.raw.created
ROUTING_KEY_ENRICHED_SUCCESS=car.enriched.success
ROUTING_KEY_ENRICHMENT_FAILED=car.enrichment.failed
ROUTING_KEY_ENRICHMENT_DLQ=car.enrichment.dlq
ROUTING_KEY_ENRICHMENT_RETRY=car.enrichment.retry
ROUTING_KEY_PRICED_SUCCESS=car.priced.success
ROUTING_KEY_PRICER_DLQ=car.pricer.dlq

ENRICHMENT_QUEUE_NAME=enrichment.raw
ENRICHMENT_DLQ_NAME=enrichment.dlq
ENRICHMENT_RETRY_QUEUE_NAME=enrichment.retry

# --- MongoDB (enrichment state) ---
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=autopulse
MONGODB_COLLECTION_LISTINGS=listings
MONGODB_COLLECTION_INBOX=consumer_inbox
MONGODB_COLLECTION_OUTBOX=publisher_outbox

# --- MySQL (pricing results) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=autopulse
MYSQL_PASSWORD=autopulse
MYSQL_ROOT_PASSWORD=autopulse
MYSQL_DATABASE=autopulse_pricing

# --- Enrichment service ---
ENRICHMENT_HOST=0.0.0.0
ENRICHMENT_PORT=8001
# Local default: HTTP + consumer in one process. Prod splits api/worker.
RUN_MODE=all
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=3
CV_MAX_WORKERS=4
CV_WATERMARK_ENABLED=true
CV_PLATE_ENABLED=true
CV_PLATE_ONNX_PATH=services/enrichment/models/plate_yolov8n.onnx
CV_PLATE_ONNX_URL=https://huggingface.co/joker5914/yolov8n-license-plate/resolve/main/best.onnx
CV_PLATE_CONF_THRESHOLD=0.35
CV_PLATE_IOU_THRESHOLD=0.45
CV_WATERMARK_ONNX_PATH=services/enrichment/models/scene_text_yolo11n.onnx
CV_WATERMARK_ONNX_URL=https://huggingface.co/RyanBours/yolo11n-text/resolve/main/model.onnx
CV_WATERMARK_CONF_THRESHOLD=0.25
CV_WATERMARK_IOU_THRESHOLD=0.5
ENRICHMENT_MAX_RETRIES=5
ENRICHMENT_RETRY_BASE_DELAY_SEC=1
ENRICHMENT_RETRY_MAX_DELAY_SEC=30
SHUTDOWN_TIMEOUT_SEC=10
RABBITMQ_PREFETCH=4
RABBITMQ_CONNECTION_NAME=autopulse-enrichment
ADMIN_UI_ENABLED=true
DEALER_UI_ENABLED=true
# Empty UI_AUTH_PASSWORD = open UIs/admin APIs (local DX). Set a password
# to require HTTP Basic (user below) or header X-API-Key: <password>.
# Shared by enrichment (/admin, /dealer) and pricer (/api/v1/admin).
UI_AUTH_USERNAME=autopulse
UI_AUTH_PASSWORD=
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
PRICER_BASE_URL=http://pricer:8002
PRICER_ADMIN_TIMEOUT_SEC=2
# Ops queue cards: work/retry bad above WARN; DLQ bad above DLQ warn (0=any).
ADMIN_QUEUE_WARN_DEPTH=100
ADMIN_DLQ_WARN_DEPTH=0
CRAWLER_BASE_URL=http://crawler:8003
CRAWLER_TIMEOUT_SEC=5
# Browser-facing scrape links for the ops dashboard (host ports from compose.override).
METRICS_SCRAPE_URL=http://127.0.0.1:9091/metrics
PRICER_METRICS_SCRAPE_URL=http://127.0.0.1:9092/metrics

# --- Crawler adapters (ingest edge) ---
CRAWLER_HOST=0.0.0.0
CRAWLER_PORT=8003
ENRICHMENT_BASE_URL=http://127.0.0.1:8001
ENRICHMENT_TIMEOUT_SEC=10

# --- Pricer service ---
PRICER_HOST=0.0.0.0
PRICER_PORT=8002
DEFAULT_TARGET_MARGIN_PCT=12.0
DEFAULT_TURNOVER_DAYS=21
AUTO_CREATE_TABLES=true
PRICER_MAX_RETRIES=5
PRICER_RETRY_BASE_DELAY_SEC=1
PRICER_RETRY_MAX_DELAY_SEC=30
PRICING_ENGINE=rules

# --- Observability ---
LOG_LEVEL=INFO
ENVIRONMENT=local
# Prometheus scrape ports (not on the public API). Bind localhost in compose.override.
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
# Enrichment default 9091 / pricer default 9092 (set per service in prod env files).
# METRICS_PORT=9091
# Optional: ClickHouse / Grafana (compose profile observability)
CLICKHOUSE_USER=autopulse
CLICKHOUSE_PASSWORD=autopulse
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
